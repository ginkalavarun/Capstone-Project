# CampusBite backend — LOCAL development environment (D23).
#
# Copy to `backend/.env` and fill in real values:
#   cp .env.example .env
# The real `.env` is gitignored and never shared. NEVER commit real secrets.
#
# Generate a real JWT secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database (D1): relative path → backend/data/ (gitignored) ---
DATABASE_URL=sqlite:///./data/campusbite.db

# --- Auth (D4): a safe, random, ≥16-byte value. The app REFUSES to start
# while this is a known placeholder (the value below is one of them). ---
JWT_SECRET=change-me-generate-a-long-random-value

# Access-token lifetime in minutes (1–1440).
JWT_EXPIRE_MINUTES=60

# --- CORS (D10): explicit frontend origins, comma-separated; no wildcards ---
CORS_ORIGINS=http://localhost:5173

# --- Reminder scanner (D6) ---
REMINDER_SCANNER_ENABLED=true
REMINDER_INTERVAL_SECONDS=60
REMINDER_STALE_MINUTES=15

# --- Optional SQLite WAL (N7): off by default; enable only if write
# contention ever matters in local development ---
# ENABLE_SQLITE_WAL=true

# --- AI insights (D9): the OpenAI key is OPTIONAL — every non-AI feature
# works without it. Never put this value in the frontend. ---
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI insights (D9), optional tuning (defaults shown) ---
# OPENAI_API_KEY=            # the whole app works without it (the Insights
#                            # page shows a "not configured" notice + the
#                            # exact app-computed figures). Backend-only.
# AI_RATE_LIMIT=10           # per user, per window (in-memory; resets on
# AI_RATE_WINDOW_MINUTES=10  # restart — single-worker deployment only)
# AI_MAX_QUESTION_CHARS=500
# AI_HISTORY_WINDOW=50
# OPENAI_TIMEOUT_SECONDS=30
