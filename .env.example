# CampusBite — Docker Compose environment (D23).
#
#   cp .env.example .env      # then replace the placeholder JWT_SECRET
#   docker compose up --build
#
# Every value here is a *placeholder*: the real `.env` is gitignored and
# never shared. The app REFUSES to start while JWT_SECRET is a known
# placeholder (D4 fail-fast). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Inside the container the database file lives on the /data named volume.
# Four slashes = absolute path (SQLite URL syntax).
DATABASE_URL=sqlite:////data/campusbite.db

# Safe, random, at least 16 bytes. See the command above.
JWT_SECRET=change-me-generate-a-long-random-value

# Access-token lifetime in minutes.
JWT_EXPIRE_MINUTES=60

# Explicit frontend origins, comma-separated (no wildcards, D10).
CORS_ORIGINS=http://localhost:5173

# Host port the backend is published on.
BACKEND_HOST_PORT=8000

# Reminder scanner (D6).
REMINDER_SCANNER_ENABLED=true
REMINDER_INTERVAL_SECONDS=60
REMINDER_STALE_MINUTES=15

# AI insights (D9): OPTIONAL — the whole core works without a key.
# Never put this value anywhere in the frontend.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
