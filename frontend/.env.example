# CampusBite frontend environment (FE: no secrets in frontend env — D23).
# Copy to `.env` and adjust if the backend is not on the default address.
#
# Base URL of the backend API. In development the Vite dev server runs on
# http://localhost:5173 (allowed by the backend's CORS allowlist, D10) and
# the Dockerized backend on http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1
